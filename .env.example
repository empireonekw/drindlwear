MONGODB_URI=
# Optional: database name when MONGODB_URI doesn't include one
MONGODB_DB=

# Admin account created by `npm run seed:admin`
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required. A long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Optional security settings (defaults shown)
# Header your host/proxy sets to the real client IP: x-real-ip on Vercel and nginx.
TRUSTED_IP_HEADER=
# New accounts allowed per IP address within ACCOUNTS_PER_IP_WINDOW_DAYS.
MAX_ACCOUNTS_PER_IP=5
ACCOUNTS_PER_IP_WINDOW_DAYS=30
